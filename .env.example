# Norelle Ropa - Variables de entorno de ejemplo
# Copia este archivo a `.env` y completa los valores reales.

# Número de WhatsApp de la tienda (código de país + número, sin símbolos).
# Ejemplo El Salvador (+503): 50377777777
NORELLE_WHATSAPP_NUMBER=

# Correo de contacto de la tienda
NORELLE_EMAIL=norelle.sv@gmail.com

# Instagram
NORELLE_INSTAGRAM=https://www.instagram.com/norelle.sv

# Moneda
NORELLE_CURRENCY=USD
NORELLE_CURRENCY_SYMBOL=$
